{
  "name": "vue-scoped-context",
  "version": "0.1.0",
  "description": "Type-safe, subtree-scoped context utilities for Vue 3",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lethme/vue-scoped-context.git",
    "directory": "packages/vue-scoped-context"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "vitest",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:ssr && pnpm test:types",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:ssr": "vitest run --config vitest.ssr.config.ts",
    "test:types": "tsc --project tsconfig.type-tests.json",
    "test:watch:unit": "vitest --config vitest.config.ts",
    "test:watch:integration": "vitest --config vitest.integration.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/server-renderer": "^3.5.45",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.0.0",
    "jsdom": "^31.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "5.0.5",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  }
}
