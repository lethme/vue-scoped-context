{
  "name": "vue-scoped-context-devtools",
  "version": "0.1.0",
  "description": "Vue Devtools inspector for vue-scoped-context",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "src"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/lethme/vue-scoped-context.git",
    "directory": "packages/vue-scoped-context-devtools"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "vue-scoped-context": "^0.1.0"
  },
  "dependencies": {
    "@vue/devtools-api": "^8.2.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vue": "^3.5.0",
    "vue-scoped-context": "workspace:*"
  }
}
